{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "ChoicePie",
    "Audience": "ChoicePie",
    "AccessTokenExpirationSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000", "https://choicepie-dev.minjie.demo" ]
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "noreply@choicepie.local",
    "FromName": "ChoicePie",
    "UseSsl": true,
    "FrontendBaseUrl": "http://localhost:3000"
  },
  "Google": {
    "ClientId": ""
  },
  "AiQuizGeneration": {
    "Provider": "Anthropic",
    "ApiKey": "",
    "Model": "claude-sonnet-5"
  },
  "CloudflareR2": {
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "Endpoint": "",
    "BucketName": "",
    "PublicBaseUrl": ""
  },
  "ForwardedHeaders": {
    "KnownProxies": [ "127.0.0.1", "::1" ],
    "KnownNetworks": []
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 10, "WindowSeconds": 60 },
    "Email": { "PermitLimit": 5, "WindowSeconds": 900 },
    "Ai": { "PermitLimit": 5, "WindowSeconds": 60 },
    "Write": { "PermitLimit": 30, "WindowSeconds": 60 },
    "Global": { "PermitLimit": 300, "WindowSeconds": 60 }
  },
  "Sentry": {
    "Dsn": "",
    "TracesSampleRate": 0
  }
}
