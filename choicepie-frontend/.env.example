# 前端（CSR）只會呼叫同源的 Nuxt server（server/api/**），不會直接跨網域打後端，
# 所以這個值目前只有 SignalR（useGameRoom.ts）會用到，用來連線 /api/gamehub。
# 留空即可：預設指向 https://choicepie-dev-api.minjie.demo。
NUXT_PUBLIC_API_BASE_URL=

# Nitro server routes（server/api/**）用來呼叫真正後端的位址，server-only，不會進到前端 bundle。
# 留空即可：預設與 NUXT_PUBLIC_API_BASE_URL 相同，指向 https://choicepie-dev-api.minjie.demo。
NUXT_BACKEND_API_URL=

# Google OAuth Client ID（Google Identity Services，公開值，不含 secret）
NUXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Sentry 前端錯誤監控（可選）---
# DSN 為空時 Sentry 完全不會初始化。DSN 是公開值，不含 secret。
NUXT_PUBLIC_SENTRY_DSN=
# 環境名稱（預設為 NODE_ENV），例如 production / staging。
NUXT_PUBLIC_SENTRY_ENVIRONMENT=
# 效能追蹤取樣率 0~1，預設 0（關閉）。
NUXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# Source map 上傳目前在 nuxt.config.ts 以 sentry.sourcemaps.disable 關閉。
# 若要啟用，需移除該設定，並在 CI/build 環境提供下列（secret，切勿提交）：
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
